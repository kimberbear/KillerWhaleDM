ACTOR CWDM_shell : Ammo  12300
{
//$Category Ammo
//$Title "Shells (4 shells)"
//$Sprite SHELA0
	Inventory.RestrictedTo "CWDM_shotgunnerClass"
	Inventory.PickupSound "ammoget"
	Inventory.RespawnTics  200 
    Radius 16
    Height 24
	Inventory.Icon "SHELA0"
	Inventory.PickupMessage "$SHELLSMALL"
	Inventory.Amount 4
	Inventory.MaxAmount 34
	Ammo.BackpackAmount 4
	Ammo.BackpackMaxAmount 34
	states
	{
	Spawn:
		SHEL A -1
		stop
	}
}

ACTOR CWDM_shellBox : CWDM_shell 12301
{
//$Category Ammo
//$Title "Shell Box (10 shells)"
//$Sprite SHELB0
	Inventory.Icon "SHELB0"
	Inventory.PickupMessage "$SHELLBOX"
	Inventory.Amount 10
	Ammo.BackpackAmount 10
	states
	{
	Spawn:
		SHEL B -1
		stop
	}
}

